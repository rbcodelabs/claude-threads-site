---
import WorkspacePreview from './WorkspacePreview.astro';
---

<section class="landing-hero" aria-labelledby="landing-title">
  <div class="landing-eyebrow"><span class="landing-dot" aria-hidden="true"></span>Your vault. A few extra hands.</div>
  <h1 id="landing-title">Big ideas.<br />A little more <em>parallel.</em></h1>
  <p class="landing-lead">
    Give each task an agent. Keep the conversations, the context, and the work right inside your vault.
  </p>
  <div class="landing-actions">
    <a class="landing-btn" href="#start">Meet your new workspace <span aria-hidden="true">↗</span></a>
    <a class="landing-btn landing-btn-secondary" href="#workflow">See how it works <span aria-hidden="true">↓</span></a>
  </div>
  <p class="landing-hosts">
    Claude Code &amp; OpenAI Codex · Works with
    <a href="https://geode.rbcodelabs.com" target="_blank" rel="noopener noreferrer">Geode</a>
    and
    <a href="https://obsidian.md" target="_blank" rel="noopener noreferrer">Obsidian</a>
  </p>

  <WorkspacePreview />

  <div class="landing-benefit-strip" aria-label="Product benefits">
    <span>↗ Independent agent sessions</span>
    <span>▤ Context from your vault</span>
    <span>✓ Review before moving on</span>
  </div>
</section>
