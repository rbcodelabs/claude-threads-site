---
const GITHUB_URL = 'https://github.com/rbcodelabs/obsidian-claude-threads';
const GEODE_URL = 'https://geode.rbcodelabs.com';
const OBSIDIAN_URL = 'https://obsidian.md';
const ROADMAP_URL = 'https://compass.rbcodelabs.com/portal/rbcodelabs/claude-threads/roadmap';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div>
      <a class="site-footer-brand" href="/"><span aria-hidden="true">↗</span> Agent Threads</a>
      <p>
        Claude Code and OpenAI Codex sessions in
        <a href={GEODE_URL} target="_blank" rel="noopener noreferrer">Geode</a>
        and
        <a href={OBSIDIAN_URL} target="_blank" rel="noopener noreferrer">Obsidian</a>.
      </p>
    </div>

    <nav class="site-footer-links" aria-label="Footer navigation">
      <a href="/docs/">Documentation</a>
      <a href="/changelog/">Changelog</a>
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={ROADMAP_URL} target="_blank" rel="noopener noreferrer">Roadmap</a>
    </nav>

    <p>&copy; {currentYear} Rick Bowman.</p>
  </div>
</footer>
