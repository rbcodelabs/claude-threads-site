---
import { Image } from 'astro:assets';
import screenshotMain from '../assets/screenshots/screenshot-main.png';
import screenshotSlashCommands from '../assets/screenshots/screenshot-slash-commands.png';
import screenshotKanbanStatus from '../assets/screenshots/screenshot-kanban-status.png';
import screenshotKanbanFolder from '../assets/screenshots/screenshot-kanban-folder.png';
import screenshotPermission from '../assets/screenshots/screenshot-permission.png';
import screenshotMobileConnected from '../assets/screenshots/screenshot-mobile-connected.png';

const shots = [
  {
    src: screenshotMain,
    alt: 'Main view: conversation panel with tool calls and Agents List showing thread status and activity',
    caption: 'Conversation panel with tool calls and Agents List showing thread status and activity',
  },
  {
    src: screenshotSlashCommands,
    alt: 'Slash command autocomplete showing installed skills from ~/.claude/skills/',
    caption: 'Slash command autocomplete surfaces built-in commands and your installed skills',
  },
  {
    src: screenshotKanbanStatus,
    alt: 'Kanban board grouping agent threads by status column',
    caption: 'Kanban board view groups threads by state: idle, running, waiting, done',
  },
  {
    src: screenshotKanbanFolder,
    alt: 'Kanban board grouped into folder swimlanes by project',
    caption: 'Group the board into folder swimlanes to see every thread for a codebase together',
  },
  {
    src: screenshotPermission,
    alt: 'Inline permission dialog — Deny / Allow / Always Allow before Claude writes a file',
    caption: 'Inline permission dialog: Deny, Allow, or Always Allow before Claude writes a file',
  },
  {
    src: screenshotMobileConnected,
    alt: 'Agent Threads connected and running from a mobile device',
    caption: 'Stay connected to your running threads from a mobile device',
  },
];
---

<section id="screenshots" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">See it in your vault</h2>
    <p class="mt-4 text-[rgb(var(--color-text-muted))]">
      A closer look at the conversation panel, the Agents List, and the controls that keep every thread under
      control.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2">
    {
      shots.map((shot) => (
        <figure class="card overflow-hidden shadow-lg shadow-black/30">
          <Image src={shot.src} alt={shot.alt} width={1000} class="w-full" />
          <figcaption class="border-t border-[rgb(var(--color-border))] px-5 py-4 text-sm text-[rgb(var(--color-text-muted))]">
            {shot.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
