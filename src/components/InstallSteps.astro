---
import CodeBlock from './CodeBlock.astro';

const bratSteps = [
  {
    title: 'Install the BRAT plugin',
    description: 'Install BRAT from Obsidian’s Community Plugins.',
  },
  {
    title: 'Open BRAT settings',
    description: 'Go to BRAT settings → Add Beta Plugin.',
  },
  {
    title: 'Enter the repo',
    description: 'Paste the repository below into the Add Beta Plugin dialog.',
  },
  {
    title: 'Enable the plugin',
    description: 'Enable Claude Threads in Settings → Community Plugins.',
  },
];

const manualSteps = [
  {
    title: 'Download the latest release',
    description: 'Grab the latest build from GitHub Releases.',
  },
  {
    title: 'Extract into your vault',
    description: 'Unzip into <vault>/.obsidian/plugins/claude-threads/.',
  },
  {
    title: 'Enable the plugin',
    description: 'Enable Claude Threads in Settings → Community Plugins.',
  },
];
---

<section id="install" class="border-y border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface-alt))]/40">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Installation</h2>
      <p class="mt-4 text-[rgb(var(--color-text-muted))]">
        BRAT is recommended for early access to the latest builds; manual install works too.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h3 class="text-lg font-bold">Via BRAT <span class="text-sm font-medium text-[rgb(var(--color-text-muted))]">(recommended)</span></h3>
        <ol class="mt-6 space-y-5">
          {
            bratSteps.map((step, i) => (
              <li class="flex gap-4">
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
                  style="background: linear-gradient(135deg, #7C3AED, #6366F1);"
                >
                  {i + 1}
                </span>
                <div class="w-full">
                  <p class="font-semibold">{step.title}</p>
                  <p class="mt-1 text-sm text-[rgb(var(--color-text-muted))]">{step.description}</p>
                  {i === 2 && <div class="mt-3"><CodeBlock code="rbcodelabs/obsidian-claude-threads" /></div>}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <h3 class="text-lg font-bold">Manual install</h3>
        <ol class="mt-6 space-y-5">
          {
            manualSteps.map((step, i) => (
              <li class="flex gap-4">
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[rgb(var(--color-border))] text-sm font-bold text-[rgb(var(--color-text))]"
                >
                  {i + 1}
                </span>
                <div class="w-full">
                  <p class="font-semibold">{step.title}</p>
                  <p class="mt-1 text-sm text-[rgb(var(--color-text-muted))]">{step.description}</p>
                  {i === 1 && (
                    <div class="mt-3">
                      <CodeBlock code="<vault>/.obsidian/plugins/claude-threads/" />
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
