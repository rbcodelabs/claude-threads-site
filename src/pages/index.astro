---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ScreenshotShowcase from '../components/ScreenshotShowcase.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Prerequisites from '../components/Prerequisites.astro';
import InstallSteps from '../components/InstallSteps.astro';
import RoadmapCTA from '../components/RoadmapCTA.astro';

const title = 'Agent Threads for Obsidian — Run AI agents in your sidebar';
const description =
  'Agent Threads embeds Claude Code and OpenAI Codex directly in your Obsidian sidebar. Run multiple sessions in parallel with streaming responses, the Agents List, a kanban board, slash commands, and inline permission dialogs.';
---

<Layout title={title} description={description}>
  <Hero />
  <ScreenshotShowcase />
  <FeatureGrid />
  <Prerequisites />
  <InstallSteps />
  <RoadmapCTA />
</Layout>
