---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { groupByMinor, versionAnchorId } from '../../lib/changelog';

const RELEASES_URL = 'https://github.com/rbcodelabs/obsidian-claude-threads/releases';

const allEntries = await getCollection('changelog');
const sortedEntries = [...allEntries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = groupByMinor(sortedEntries);

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const title = 'Changelog — Agent Threads for Geode and Obsidian';
const description =
  'Every release of Agent Threads for Geode and Obsidian, from v0.1.0 to the latest version, with full release notes pulled from GitHub.';
---

<Layout title={title} description={description}>
  <section class="changelog-page">
    <div class="changelog-hero">
      <div class="docs-kicker">Release history</div>
      <h1>Changelog</h1>
      <p>
        Every release of Agent Threads for Geode and Obsidian, tracked here in full. For the unstyled view, see the
        {' '}
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
          raw GitHub Releases list
        </a>.
      </p>
    </div>

    <nav aria-label="Jump to version" class="changelog-version-nav">
      {
        groups.map((group) => (
          <a href={`#${group.id}`}>{group.label}</a>
        ))
      }
    </nav>

    <details class="changelog-mobile-jump">
      <summary>Jump to version</summary>
      <nav aria-label="Jump to version">
        {groups.map((group) => <a href={`#${group.id}`}>{group.label}</a>)}
      </nav>
    </details>

    <div class="changelog-groups">
      {
        groups.map(async (group) => (
          <section class="changelog-group">
            <h2 id={group.id}>{group.label}</h2>

            <div class="changelog-entries">
              {await Promise.all(
                group.entries.map(async (entry) => {
                  const { Content } = await render(entry);
                  const id = versionAnchorId(entry.data.version);
                  return (
                    <article class="changelog-entry">
                      <header id={id}>
                        <span class="changelog-version">v{entry.data.version}</span>
                        <span class="changelog-date">{dateFormatter.format(entry.data.date)}</span>
                        <a
                          href={entry.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          View on GitHub
                        </a>
                      </header>
                      <div class="docs-content changelog-content">
                        <div>
                          <Content />
                        </div>
                      </div>
                    </article>
                  );
                })
              )}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</Layout>
