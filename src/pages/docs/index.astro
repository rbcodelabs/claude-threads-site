---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_ORDER, CATEGORY_LABELS, sortDocs } from '../../lib/docsCategories';

const allDocs = sortDocs(await getCollection('docs'));

const categories = CATEGORY_ORDER.map((category) => {
  const items = allDocs.filter((d) => d.data.category === category);
  return { category, label: CATEGORY_LABELS[category] ?? category, items, first: items[0] };
}).filter((c) => c.items.length > 0);

const title = 'Documentation — Agent Threads for Geode and Obsidian';
const description =
  'Full user documentation for Agent Threads: getting started, core workflow, views, automation, permissions, integrations, and reference pages for settings, commands, and agent tools.';
---

<Layout title={title} description={description}>
  <section class="docs-index">
    <div class="docs-index-hero">
      <div class="docs-kicker">Learn Agent Threads</div>
      <h1>Documentation</h1>
      <p>
        Everything you need to run Claude Code or OpenAI Codex inside
        <a href="https://geode.rbcodelabs.com" target="_blank" rel="noopener noreferrer">Geode</a>
        or
        <a href="https://obsidian.md" target="_blank" rel="noopener noreferrer">Obsidian</a>
        — from your first thread to the full agent tools reference.
      </p>
    </div>

    <div class="docs-category-grid">
      {
        categories.map((cat) => (
          <section class="docs-category-card card">
            <h2>
              <a href={`/docs/${cat.first.id}/`}>{cat.label} <span aria-hidden="true">↗</span></a>
            </h2>
            <p>{cat.first.data.description}</p>
            <ul>
              {cat.items.map((item) => (
                <li>
                  <a href={`/docs/${item.id}/`}>{item.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Layout>
